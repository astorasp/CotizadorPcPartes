    %% === RELACIONES ENTRE PAQUETES ===
    
    %% Aplicación -> Config
    App -.->|"configura beans"| config
    
    %% Controlador -> Otros paquetes
    controlador -->|"recibe requests<br/>retorna responses"| dto
    controlador -->|"invoca lógica<br/>de negocio"| servicio
    controlador -->|"mapea HTTP status<br/>maneja errores"| util
    
    %% Servicio -> Otros paquetes
    servicio -->|"usa cotizadores<br/>e impuestos"| dominio
    servicio -->|"convierte DTOs<br/>con mappers"| dto
    servicio -->|"persiste y<br/>consulta datos"| repositorio
    servicio -->|"convierte a/desde<br/>entidades JPA"| entidad
    servicio -->|"maneja códigos<br/>de error"| util
    
    %% DTO -> Otros paquetes
    dto -->|"mappers crean<br/>objetos dominio"| dominio
    dto -->|"mappers convierten<br/>a/desde JPA"| entidad
    
    %% Repositorio -> Entidades
    repositorio -->|"operaciones CRUD<br/>sobre entidades JPA"| entidad
    
    %% Excepción -> Otros paquetes
    excepcion -->|"usa ApiResponse<br/>para errores"| dto
    excepcion -->|"obtiene códigos<br/>de error"| util
    
    %% Config -> Otros paquetes
    config -.->|"configura JPA<br/>y cache"| repositorio
    config -.->|"integra con<br/>seguridad"| security
    config -.->|"inyecta beans<br/>RestTemplate"| servicio
    
    %% Security -> Controlador
    security -.->|"filtra requests<br/>valida JWT"| controlador
    
